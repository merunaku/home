<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SCADA HMI - Secuencia Electroneumática con Sensor Analógico</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        scada: {
                            bg: '#0f172a',
                            panel: '#1e293b',
                            panelBorder: '#334155',
                            accent: '#06b6d4',
                            warning: '#f59e0b',
                            danger: '#ef4444',
                            success: '#10b981',
                            off: '#475569'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                        mono: ['Consolas', 'Courier New', 'monospace']
                    }
                }
            }
        }
    </script>
    <style>
        /* Modern Industrial Scrollbar & Aesthetics */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #0f172a; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #06b6d4; }
        
        /* Custom Glowing & Indicator LED Effects */
        .led-glow-green { box-shadow: 0 0 12px #10b981, inset 0 0 4px #a7f3d0; }
        .led-glow-red { box-shadow: 0 0 12px #ef4444, inset 0 0 4px #fecaca; }
        .led-glow-amber { box-shadow: 0 0 14px #f59e0b, inset 0 0 4px #fef08a; }
        .led-glow-cyan { box-shadow: 0 0 14px #06b6d4, inset 0 0 4px #cff4fc; }

        /* Custom Range Slider Styling */
        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            height: 24px;
            width: 24px;
            border-radius: 50%;
            background: #06b6d4;
            cursor: pointer;
            box-shadow: 0 0 10px rgba(6, 182, 212, 0.8);
            border: 2px solid #ffffff;
            margin-top: -8px;
        }
        input[type=range]::-webkit-slider-runnable-track {
            width: 100%;
            height: 8px;
            cursor: pointer;
            background: #334155;
            border-radius: 4px;
        }

        /* Pulse Animation for Waiting State */
        @keyframes pulse-border {
            0%, 100% { border-color: rgba(245, 158, 11, 0.4); box-shadow: 0 0 5px rgba(245, 158, 11, 0.2); }
            50% { border-color: rgba(245, 158, 11, 1); box-shadow: 0 0 20px rgba(245, 158, 11, 0.6); }
        }
        .pulse-wait { animation: pulse-border 1.5s infinite; }
    </style>
</head>
<body class="bg-scada-bg text-slate-100 font-sans min-h-screen flex flex-col justify-between select-none overflow-x-hidden">

    <!-- TOP SCADA HEADER BAR -->
    <header class="bg-scada-panel border-b border-scada-panelBorder px-6 py-3 flex flex-wrap items-center justify-between gap-4 shadow-lg">
        <div class="flex items-center space-x-3">
            <div class="p-2 bg-cyan-950 border border-cyan-500/40 rounded-lg text-scada-accent">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
            </div>
            <div>
                <h1 class="font-bold text-lg leading-tight tracking-wide text-slate-100">SCADA INDUSTRIAL HMI</h1>
                <p class="text-xs text-slate-400 font-mono">Secuencia Electroneumática: <span class="text-cyan-400 font-semibold">A+ &rarr; [Check P] &rarr; B+ &rarr; B- &rarr; A-</span></p>
            </div>
        </div>

        <!-- Telemetry & Mode Summary -->
        <div class="flex items-center space-x-6 text-xs font-mono">
            <div class="flex items-center space-x-2 bg-slate-900/80 px-3 py-1.5 rounded border border-slate-700">
                <span class="text-slate-400">OPC UA:</span>
                <span class="flex items-center text-emerald-400 font-semibold">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping mr-1.5"></span>
                    CONECTADO (FluidSIM)
                </span>
            </div>
            <div class="flex items-center space-x-2 bg-slate-900/80 px-3 py-1.5 rounded border border-slate-700">
                <span class="text-slate-400">Ciclos Completados:</span>
                <span id="cycleCounter" class="text-cyan-400 font-bold text-sm">0</span>
            </div>
            <div class="flex items-center space-x-2 bg-slate-900/80 px-3 py-1.5 rounded border border-slate-700">
                <span class="text-slate-400">Estado PLC:</span>
                <span id="plcModeBadge" class="text-amber-400 font-bold">REPOSO (ST 0)</span>
            </div>
        </div>
    </header>

    <!-- MAIN SYSTEM CONTENT SPLIT -->
    <main class="p-4 md:p-6 flex-grow grid grid-cols-1 lg:grid-cols-12 gap-6 max-w-[1800px] w-full mx-auto">
        
        <!-- LEFT COLUMN: PHYSICAL PNEUMATIC ANIMATION & ACTUATORS (7 COLS) -->
        <section class="lg:col-span-7 flex flex-col gap-4">
            
            <!-- Pneumatic Canvas Visualization Panel -->
            <div class="bg-scada-panel border border-scada-panelBorder rounded-xl p-4 shadow-xl flex flex-col justify-between flex-grow">
                <div class="flex items-center justify-between mb-2">
                    <h2 class="text-sm font-semibold tracking-wider text-slate-300 uppercase flex items-center">
                        <svg class="w-4 h-4 mr-2 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                        </svg>
                        Esquema Físico Electroneumático (FluidSIM Virtual)
                    </h2>
                    
                    <!-- Cylinder Speed Controls -->
                    <div class="flex items-center space-x-2 text-xs font-mono">
                        <span class="text-slate-400">Velocidad:</span>
                        <button id="btnSpeedSlow" onclick="setSpeed(0.5)" class="px-2 py-0.5 rounded bg-slate-700 hover:bg-slate-600">0.5x</button>
                        <button id="btnSpeedNorm" onclick="setSpeed(1.0)" class="px-2 py-0.5 rounded bg-cyan-700 text-white font-bold">1.0x</button>
                        <button id="btnSpeedFast" onclick="setSpeed(2.0)" class="px-2 py-0.5 rounded bg-slate-700 hover:bg-slate-600">2.0x</button>
                    </div>
                </div>

                <!-- Interactive Canvas Container -->
                <div class="relative w-full h-[380px] bg-slate-950 rounded-lg border border-slate-800 overflow-hidden flex items-center justify-center">
                    <canvas id="pneumaticCanvas" class="w-full h-full block"></canvas>
                </div>

                <!-- Actuators & Sensors Telemetry Strip -->
                <div class="mt-4 grid grid-cols-2 md:grid-cols-4 gap-3 text-xs">
                    <!-- Sensor A Status -->
                    <div class="bg-slate-900 border border-slate-800 p-2.5 rounded-lg flex items-center justify-between">
                        <div>
                            <div class="text-slate-400 font-mono">Cilindro A (Sujeción)</div>
                            <div class="font-bold text-slate-200" id="posAText">Pos: 0 mm</div>
                        </div>
                        <div class="flex flex-col items-end gap-1 font-mono text-[10px]">
                            <span id="badgeA0" class="px-1.5 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800">a0: 1</span>
                            <span id="badgeA1" class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-500 border border-slate-700">a1: 0</span>
                        </div>
                    </div>

                    <!-- Sensor B Status -->
                    <div class="bg-slate-900 border border-slate-800 p-2.5 rounded-lg flex items-center justify-between">
                        <div>
                            <div class="text-slate-400 font-mono">Cilindro B (Estampado)</div>
                            <div class="font-bold text-slate-200" id="posBText">Pos: 0 mm</div>
                        </div>
                        <div class="flex flex-col items-end gap-1 font-mono text-[10px]">
                            <span id="badgeB0" class="px-1.5 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800">b0: 1</span>
                            <span id="badgeB1" class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-500 border border-slate-700">b1: 0</span>
                        </div>
                    </div>

                    <!-- Solenoids Valve A -->
                    <div class="bg-slate-900 border border-slate-800 p-2.5 rounded-lg flex items-center justify-between">
                        <div>
                            <div class="text-slate-400 font-mono">Válvula A (5/2)</div>
                            <div class="font-bold text-slate-300">Bi-estable</div>
                        </div>
                        <div class="flex gap-1 font-mono text-[10px]">
                            <span id="badgeY1" class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-500 border border-slate-700">Y1 (A+)</span>
                            <span id="badgeY2" class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-500 border border-slate-700">Y2 (A-)</span>
                        </div>
                    </div>

                    <!-- Solenoids Valve B -->
                    <div class="bg-slate-900 border border-slate-800 p-2.5 rounded-lg flex items-center justify-between">
                        <div>
                            <div class="text-slate-400 font-mono">Válvula B (5/2)</div>
                            <div class="font-bold text-slate-300">Bi-estable</div>
                        </div>
                        <div class="flex gap-1 font-mono text-[10px]">
                            <span id="badgeY3" class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-500 border border-slate-700">Y3 (B+)</span>
                            <span id="badgeY4" class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-500 border border-slate-700">Y4 (B-)</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PLC Machine State Visual Sequence Bar -->
            <div class="bg-scada-panel border border-scada-panelBorder rounded-xl p-4 shadow-xl">
                <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Progreso de Secuencia PLC (Máquina de Estados ST)</h3>
                <div class="grid grid-cols-5 gap-2 text-center text-xs font-mono">
                    <div id="stepBox10" class="p-2 rounded-lg bg-slate-800 border border-slate-700 text-slate-400 transition-all">
                        <div class="font-bold">PASO 10</div>
                        <div class="text-[10px] mt-0.5">1. Avanzar A (A+)</div>
                    </div>
                    <div id="stepBox20" class="p-2 rounded-lg bg-slate-800 border border-slate-700 text-slate-400 transition-all">
                        <div class="font-bold">PASO 20</div>
                        <div class="text-[10px] mt-0.5">2. Check Presión</div>
                    </div>
                    <div id="stepBox30" class="p-2 rounded-lg bg-slate-800 border border-slate-700 text-slate-400 transition-all">
                        <div class="font-bold">PASO 30</div>
                        <div class="text-[10px] mt-0.5">3. Avanzar B (B+)</div>
                    </div>
                    <div id="stepBox40" class="p-2 rounded-lg bg-slate-800 border border-slate-700 text-slate-400 transition-all">
                        <div class="font-bold">PASO 40</div>
                        <div class="text-[10px] mt-0.5">4. Retornar B (B-)</div>
                    </div>
                    <div id="stepBox50" class="p-2 rounded-lg bg-slate-800 border border-slate-700 text-slate-400 transition-all">
                        <div class="font-bold">PASO 50</div>
                        <div class="text-[10px] mt-0.5">5. Retornar A (A-)</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- RIGHT COLUMN: HMI CONTROLS & ANALOG SENSOR SIMULATOR (5 COLS) -->
        <section class="lg:col-span-5 flex flex-col gap-4">
            
            <!-- MAIN HMI OPERATOR PANEL -->
            <div id="hmiMainCard" class="bg-scada-panel border border-scada-panelBorder rounded-xl p-5 shadow-xl flex flex-col justify-between flex-grow">
                <div>
                    <!-- Header -->
                    <div class="flex items-center justify-between border-b border-slate-700/60 pb-3 mb-4">
                        <div class="flex items-center space-x-2">
                            <span class="w-3 h-3 rounded-full bg-cyan-400 led-glow-cyan"></span>
                            <h2 class="font-bold text-slate-200 tracking-wide uppercase text-sm">Panel de Operación HMI</h2>
                        </div>
                        <span class="text-xs font-mono bg-slate-900 text-slate-400 px-2 py-1 rounded border border-slate-700">CODESYS Visu Target</span>
                    </div>

                    <!-- Push Button Control Console -->
                    <div class="grid grid-cols-3 gap-3 mb-6">
                        <button id="btnStart" onclick="handleStart()" class="group relative bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white font-bold py-3 px-4 rounded-lg shadow-lg border border-emerald-400/40 transition flex flex-col items-center justify-center">
                            <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <span class="text-xs">START</span>
                        </button>

                        <button id="btnStop" onclick="handleStop()" class="group relative bg-amber-600 hover:bg-amber-500 active:bg-amber-700 text-white font-bold py-3 px-4 rounded-lg shadow-lg border border-amber-400/40 transition flex flex-col items-center justify-center">
                            <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <span class="text-xs">PARADA</span>
                        </button>

                        <button id="btnReset" onclick="handleReset()" class="group relative bg-rose-700 hover:bg-rose-600 active:bg-rose-800 text-white font-bold py-3 px-4 rounded-lg shadow-lg border border-rose-400/40 transition flex flex-col items-center justify-center">
                            <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                            </svg>
                            <span class="text-xs">RESET</span>
                        </button>
                    </div>

                    <!-- Prominent Banner for State 20 Evaluation Alert -->
                    <div id="hmiActionBanner" class="hidden mb-6 p-3.5 rounded-lg bg-amber-950/80 border border-amber-500 text-amber-200 text-xs font-mono pulse-wait flex items-center space-x-3">
                        <div class="p-2 rounded bg-amber-500 text-slate-950 flex-shrink-0 font-bold">⚠️ HMI</div>
                        <div>
                            <div class="font-bold text-amber-300">¡ESPERANDO VERIFICACIÓN DE PRESIÓN!</div>
                            <div>Arrastre el deslizador analógico abajo hasta superar el Setpoint (<b><span id="bannerSpVal">70</span>%</b>).</div>
                        </div>
                    </div>

                    <!-- SIMULATOR: ANALOG PRESSURE SENSOR INTERFACE -->
                    <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 mb-4">
                        <div class="flex items-center justify-between mb-3">
                            <label class="text-xs font-bold text-cyan-400 uppercase tracking-wider flex items-center">
                                <svg class="w-4 h-4 mr-1.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
                                </svg>
                                Transmisor Analógico de Presión (0 - 10 BAR / 0 - 100%)
                            </label>
                            <span class="text-xs font-mono px-2 py-0.5 rounded bg-cyan-950 border border-cyan-800 text-cyan-300 font-bold" id="pressureValueDisplay">0.0 %</span>
                        </div>

                        <!-- Interactive Range Slider -->
                        <div class="mb-4 px-1">
                            <input id="analogSlider" type="range" min="0" max="100" value="0" step="1" oninput="updateAnalogSensor(this.value)" class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-cyan-400">
                        </div>

                        <!-- Preset Buttons for Easy Testing -->
                        <div class="flex items-center justify-between gap-2 text-xs font-mono">
                            <span class="text-slate-500">Ajuste Rápido:</span>
                            <div class="flex gap-1.5">
                                <button onclick="setAnalogValue(0)" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300">0%</button>
                                <button onclick="setAnalogValue(50)" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300">50%</button>
                                <button onclick="setAnalogValue(75)" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300">75%</button>
                                <button onclick="setAnalogValue(100)" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300">100%</button>
                            </div>
                        </div>
                    </div>

                    <!-- SETPOINT CONFIGURATION & LIVE COMPARISON BAR -->
                    <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">
                        <div class="flex items-center justify-between mb-3 text-xs">
                            <span class="font-bold text-slate-300 uppercase tracking-wider">Configuración de Setpoint</span>
                            <div class="flex items-center space-x-2 font-mono">
                                <span class="text-slate-400">Umbral Mínimo:</span>
                                <input id="setpointInput" type="number" min="10" max="95" value="70" onchange="updateSetpoint(this.value)" class="w-16 bg-slate-950 border border-slate-700 rounded px-2 py-0.5 text-center text-cyan-400 font-bold focus:outline-none focus:border-cyan-400">
                                <span class="text-slate-400">%</span>
                            </div>
                        </div>

                        <!-- Pressure Bar Graphic (PV vs SP) -->
                        <div class="relative w-full h-7 bg-slate-950 rounded-lg border border-slate-800 overflow-hidden flex items-center mb-2">
                            <!-- Current Pressure Fill -->
                            <div id="pressureBarFill" class="h-full bg-gradient-to-r from-blue-600 via-cyan-500 to-emerald-500 transition-all duration-150" style="width: 0%;"></div>
                            <!-- Setpoint Marker Line -->
                            <div id="setpointLine" class="absolute top-0 bottom-0 w-1 bg-amber-400 shadow-[0_0_8px_#f59e0b] z-10" style="left: 70%;"></div>
                        </div>

                        <!-- Pressure Evaluation Result LED -->
                        <div class="flex items-center justify-between text-xs font-mono pt-1">
                            <span class="text-slate-400">Comparador Lógico:</span>
                            <div id="pressureStatusBadge" class="flex items-center space-x-1.5 text-rose-400 font-semibold bg-rose-950/60 px-2.5 py-1 rounded border border-rose-800/80">
                                <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                                <span>PRESIÓN INSUFICIENTE (PV &lt; SP)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- HMI System Status Annunciator -->
                <div class="mt-4 pt-3 border-t border-slate-800 grid grid-cols-2 gap-3 font-mono text-xs">
                    <div class="bg-slate-900 p-2.5 rounded-lg border border-slate-800 flex items-center space-x-2.5">
                        <span id="ledReady" class="w-3 h-3 rounded-full bg-emerald-500 led-glow-green flex-shrink-0"></span>
                        <div>
                            <div class="text-slate-400 text-[10px]">INDICADOR 1</div>
                            <div id="txtReady" class="font-bold text-emerald-400">SISTEMA LISTO</div>
                        </div>
                    </div>

                    <div class="bg-slate-900 p-2.5 rounded-lg border border-slate-800 flex items-center space-x-2.5">
                        <span id="ledRunning" class="w-3 h-3 rounded-full bg-slate-700 flex-shrink-0"></span>
                        <div>
                            <div class="text-slate-400 text-[10px]">INDICADOR 2</div>
                            <div id="txtRunning" class="font-bold text-slate-500">EN REPOSO</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- BOTTOM PLC CODE VIEWER & REALTIME LOG CONSOLE -->
    <footer class="p-4 md:p-6 pt-0 max-w-[1800px] w-full mx-auto grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- ST Code Execution Monitor (5 COLS) -->
        <div class="lg:col-span-5 bg-scada-panel border border-scada-panelBorder rounded-xl p-4 shadow-lg flex flex-col h-48">
            <div class="flex items-center justify-between mb-2 pb-1 border-b border-slate-800">
                <span class="text-xs font-bold text-slate-300 uppercase tracking-wider font-mono">Código PLC (Texto Estructurado ST - CODESYS)</span>
                <span class="text-[10px] text-cyan-400 font-mono">PLC_PRG.st</span>
            </div>
            <pre class="bg-slate-950 p-3 rounded border border-slate-800 font-mono text-[11px] text-slate-300 flex-grow overflow-y-auto leading-relaxed" id="stCodeView">
<span id="stLine0">0: IF bStart AND bReady THEN iState := 10; END_IF;</span>
<span id="stLine10">10: Y1_A_Plus := TRUE; IF a1 THEN Y1_A_Plus:=FALSE; iState:=20; END_IF;</span>
<span id="stLine20" class="text-amber-400">20: (* ESPERA HMI *) IF rAnalogSensor >= rSetPoint THEN iState:=30; END_IF;</span>
<span id="stLine30">30: Y3_B_Plus := TRUE; IF b1 THEN Y3_B_Plus:=FALSE; iState:=40; END_IF;</span>
<span id="stLine40">40: Y4_B_Minus := TRUE; IF b0 THEN Y4_B_Minus:=FALSE; iState:=50; END_IF;</span>
<span id="stLine50">50: Y2_A_Minus := TRUE; IF a0 THEN Y2_A_Minus:=FALSE; iState:=0; END_IF;</span>
</pre>
        </div>

        <!-- System Diagnostic Log Console (7 COLS) -->
        <div class="lg:col-span-7 bg-scada-panel border border-scada-panelBorder rounded-xl p-4 shadow-lg flex flex-col h-48">
            <div class="flex items-center justify-between mb-2 pb-1 border-b border-slate-800">
                <span class="text-xs font-bold text-slate-300 uppercase tracking-wider font-mono">Consola de Eventos y Comunicaciones OPC</span>
                <button onclick="clearLogs()" class="text-[10px] text-slate-400 hover:text-slate-200 font-mono">Limpiar Registro</button>
            </div>
            <div id="logConsole" class="bg-slate-950 p-3 rounded border border-slate-800 font-mono text-[11px] text-slate-300 flex-grow overflow-y-auto space-y-1">
                <!-- Log entries inserted dynamically -->
            </div>
        </div>
    </footer>

    <!-- JAVASCRIPT: PLC LOGIC SIMULATOR & CANVAS ENGINE -->
    <script>
        // --- PLC GLOBAL STATE & VARIABLES ---
        let iState = 0;              // PLC State Machine Index (0, 10, 20, 30, 40, 50)
        let bStart = false;          // HMI Start Command
        let bStop = false;           // HMI Stop Command
        let rAnalogSensor = 0.0;     // Pressure Value from HMI Slider (0 - 100%)
        let rSetPoint = 70.0;        // Target Setpoint Threshold
        let cycleCount = 0;          // Total finished cycles
        let speedMultiplier = 1.0;  // Simulation animation speed multiplier

        // --- PHYSICAL CYLINDER POSITIONS & SENSORS ---
        let posA = 0; // Cylinder A position (0 to 100 mm)
        let posB = 0; // Cylinder B position (0 to 100 mm)

        // Digital Sensor Signals (FluidSIM -> PLC Inputs)
        let a0 = true;
        let a1 = false;
        let b0 = true;
        let b1 = false;

        // Solenoid Valve Signals (PLC Outputs -> FluidSIM)
        let Y1 = false; // A+ (Extend A)
        let Y2 = false; // A- (Retract A)
        let Y3 = false; // B+ (Extend B)
        let Y4 = false; // B- (Retract B)

        // Workpiece State: 0 = None/Raw, 1 = Clamped, 2 = Stamped
        let workpieceState = 0;

        // Canvas Context & Dimensions
        const canvas = document.getElementById('pneumaticCanvas');
        const ctx = canvas.getContext('2d');

        // Spark Particle Effect System for Stamping Hit
        let sparks = [];
        let stampX = 0;
        let stampY = 0;

        // Initialization on Load
        window.onload = function() {
            resizeCanvas();
            window.addEventListener('resize', resizeCanvas);
            logEvent("PLC iniciado. Sistema en REPOSO (Paso 0). Esperando orden START.");
            
            // Start Animation & PLC Logic Loop
            requestAnimationFrame(gameLoop);
        };

        function resizeCanvas() {
            if (!canvas.parentElement) return;
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;
        }

        // --- HMI CONTROL FUNCTIONS ---
        function handleStart() {
            if (iState === 0) {
                bStart = true;
                bStop = false;
                logEvent("HMI: Botón [START] presionado.");
            } else {
                logEvent("HMI: El proceso ya se encuentra en ejecución.", "warning");
            }
        }

        function handleStop() {
            bStop = true;
            bStart = false;
            logEvent("HMI: Botón [PARADA] presionado. El proceso se detendrá.", "warning");
        }

        function handleReset() {
            iState = 0;
            bStart = false;
            bStop = false;
            Y1 = false; Y2 = false; Y3 = false; Y4 = false;
            posA = 0;
            posB = 0;
            workpieceState = 0;
            updateSensors();
            logEvent("HMI: Botón [RESET] accionado. Variables y cilindros devueltos a REPOSO.", "danger");
        }

        function updateAnalogSensor(val) {
            rAnalogSensor = parseFloat(val);
            document.getElementById('pressureValueDisplay').innerText = rAnalogSensor.toFixed(1) + " %";
            document.getElementById('pressureBarFill').style.width = rAnalogSensor + "%";
            
            // Check Comparison Condition
            const isOk = rAnalogSensor >= rSetPoint;
            const badge = document.getElementById('pressureStatusBadge');
            
            if (isOk) {
                badge.className = "flex items-center space-x-1.5 text-emerald-400 font-semibold bg-emerald-950/60 px-2.5 py-1 rounded border border-emerald-800/80";
                badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-400 led-glow-green"></span><span>PRESIÓN CORRECTA (PV &ge; SP)</span>`;
            } else {
                badge.className = "flex items-center space-x-1.5 text-rose-400 font-semibold bg-rose-950/60 px-2.5 py-1 rounded border border-rose-800/80";
                badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-rose-500"></span><span>PRESIÓN INSUFICIENTE (PV &lt; SP)</span>`;
            }
        }

        function setAnalogValue(val) {
            document.getElementById('analogSlider').value = val;
            updateAnalogSensor(val);
        }

        function updateSetpoint(val) {
            rSetPoint = parseFloat(val);
            document.getElementById('setpointLine').style.left = rSetPoint + "%";
            document.getElementById('bannerSpVal').innerText = rSetPoint;
            updateAnalogSensor(rAnalogSensor); // Refresh logic
            logEvent(`HMI: Setpoint de presión actualizado a ${rSetPoint}%`);
        }

        function setSpeed(sp) {
            speedMultiplier = sp;
            document.getElementById('btnSpeedSlow').className = sp === 0.5 ? "px-2 py-0.5 rounded bg-cyan-700 text-white font-bold" : "px-2 py-0.5 rounded bg-slate-700 hover:bg-slate-600";
            document.getElementById('btnSpeedNorm').className = sp === 1.0 ? "px-2 py-0.5 rounded bg-cyan-700 text-white font-bold" : "px-2 py-0.5 rounded bg-slate-700 hover:bg-slate-600";
            document.getElementById('btnSpeedFast').className = sp === 2.0 ? "px-2 py-0.5 rounded bg-cyan-700 text-white font-bold" : "px-2 py-0.5 rounded bg-slate-700 hover:bg-slate-600";
        }

        // --- PLC SENSOR COMPUTATION ---
        function updateSensors() {
            a0 = (posA <= 1);
            a1 = (posA >= 99);
            b0 = (posB <= 1);
            b1 = (posB >= 99);

            // Update UI Badges
            document.getElementById('posAText').innerText = `Pos: ${Math.round(posA)} mm`;
            document.getElementById('posBText').innerText = `Pos: ${Math.round(posB)} mm`;

            updateBadge('badgeA0', a0, 'a0: 1', 'a0: 0');
            updateBadge('badgeA1', a1, 'a1: 1', 'a1: 0');
            updateBadge('badgeB0', b0, 'b0: 1', 'b0: 0');
            updateBadge('badgeB1', b1, 'b1: 1', 'b1: 0');

            updateBadge('badgeY1', Y1, 'Y1 (A+)', 'Y1 (A-)');
            updateBadge('badgeY2', Y2, 'Y2 (A-)', 'Y2 (A-)');
            updateBadge('badgeY3', Y3, 'Y3 (B+)', 'Y3 (B+)');
            updateBadge('badgeY4', Y4, 'Y4 (B-)', 'Y4 (B-)');
        }

        function updateBadge(id, active, activeText, inactiveText) {
            const el = document.getElementById(id);
            if (!el) return;
            if (active) {
                el.className = "px-1.5 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800 font-bold";
                el.innerText = activeText;
            } else {
                el.className = "px-1.5 py-0.5 rounded bg-slate-800 text-slate-500 border border-slate-700";
                el.innerText = inactiveText;
            }
        }

        // --- MAIN PLC STATE MACHINE LOOP ---
        let lastTimestamp = performance.now();

        function gameLoop(timestamp) {
            const dt = Math.min((timestamp - lastTimestamp) / 1000, 0.1) * speedMultiplier;
            lastTimestamp = timestamp;

            // Physical Motion Simulation based on active Solenoid outputs
            const cylSpeed = 120; // mm per second
            if (Y1 && !Y2) posA = Math.min(100, posA + cylSpeed * dt);
            if (Y2 && !Y1) posA = Math.max(0, posA - cylSpeed * dt);
            if (Y3 && !Y4) posB = Math.min(100, posB + cylSpeed * dt);
            if (Y4 && !Y3) posB = Math.max(0, posB - cylSpeed * dt);

            updateSensors();

            // PLC State Machine Execution
            switch (iState) {
                case 0: // Reposo / Ready
                    Y1 = false; Y2 = false; Y3 = false; Y4 = false;
                    document.getElementById('plcModeBadge').innerText = "REPOSO (ST 0)";
                    document.getElementById('plcModeBadge').className = "text-amber-400 font-bold";
                    
                    document.getElementById('ledReady').className = "w-3 h-3 rounded-full bg-emerald-500 led-glow-green flex-shrink-0";
                    document.getElementById('txtReady').className = "font-bold text-emerald-400";
                    document.getElementById('ledRunning').className = "w-3 h-3 rounded-full bg-slate-700 flex-shrink-0";
                    document.getElementById('txtRunning').className = "font-bold text-slate-500";
                    document.getElementById('txtRunning').innerText = "EN REPOSO";
                    document.getElementById('hmiActionBanner').classList.add('hidden');

                    if (bStart && a0 && b0) {
                        iState = 10;
                        bStart = false;
                        logEvent("PLC: Condición de Inicio validada (a0 & b0 OK). Transición a PASO 10.");
                    }
                    break;

                case 10: // Paso 1: Avanzar A (A+)
                    Y1 = true;
                    Y2 = false;
                    document.getElementById('plcModeBadge').innerText = "EJECUCIÓN (PASO 10: A+)";
                    document.getElementById('plcModeBadge').className = "text-cyan-400 font-bold";

                    document.getElementById('ledReady').className = "w-3 h-3 rounded-full bg-slate-700 flex-shrink-0";
                    document.getElementById('txtReady').className = "font-bold text-slate-500";
                    document.getElementById('ledRunning').className = "w-3 h-3 rounded-full bg-cyan-400 led-glow-cyan flex-shrink-0";
                    document.getElementById('txtRunning').className = "font-bold text-cyan-400";
                    document.getElementById('txtRunning').innerText = "EN PROCESO";

                    if (a1) {
                        Y1 = false; // Pulsed solenoid release
                        iState = 20;
                        workpieceState = 1; // Workpiece is now clamped!
                        logEvent("PLC: Cilindro A extendido (a1 activo). Transición a PASO 20 (Verificación de Presión HMI).");
                    }
                    break;

                case 20: // Paso 2: Evaluación Analógica HMI
                    Y1 = false; Y2 = false; Y3 = false; Y4 = false;
                    document.getElementById('plcModeBadge').innerText = "ESPERANDO HMI (PASO 20)";
                    document.getElementById('plcModeBadge').className = "text-amber-400 font-bold animate-pulse";
                    document.getElementById('hmiActionBanner').classList.remove('hidden');

                    // Check if human user adjusted the pressure slider above setpoint
                    if (rAnalogSensor >= rSetPoint) {
                        document.getElementById('hmiActionBanner').classList.add('hidden');
                        iState = 30;
                        logEvent(`PLC: Presión analógica OK (${rAnalogSensor.toFixed(1)}% >= ${rSetPoint}%). Transición a PASO 30 (B+).`, "success");
                    }
                    break;

                case 30: // Paso 3: Avanzar B (B+ - Estampado)
                    Y3 = true;
                    Y4 = false;
                    document.getElementById('plcModeBadge').innerText = "EJECUCIÓN (PASO 30: B+)";
                    document.getElementById('plcModeBadge').className = "text-cyan-400 font-bold";

                    if (b1) {
                        Y3 = false;
                        iState = 40;
                        workpieceState = 2; // Workpiece Stamped!
                        createSparks();
                        logEvent("PLC: Troquel B extendido (b1 activo). Estampado realizado. Transición a PASO 40 (B-).");
                    }
                    break;

                case 40: // Paso 4: Retroceder B (B-)
                    Y3 = false;
                    Y4 = true;
                    document.getElementById('plcModeBadge').innerText = "EJECUCIÓN (PASO 40: B-)";

                    if (b0) {
                        Y4 = false;
                        iState = 50;
                        logEvent("PLC: Cilindro B retornado (b0 activo). Transición a PASO 50 (A-).");
                    }
                    break;

                case 50: // Paso 5: Retroceder A (A-)
                    Y1 = false;
                    Y2 = true;
                    document.getElementById('plcModeBadge').innerText = "EJECUCIÓN (PASO 50: A-)";

                    if (a0) {
                        Y2 = false;
                        iState = 0;
                        cycleCount++;
                        document.getElementById('cycleCounter').innerText = cycleCount;
                        logEvent(`PLC: Secuencia completada con éxito. Ciclos totales: ${cycleCount}`, "success");
                    }
                    break;
            }

            // Update State Highlight UI
            highlightStep(iState);
            highlightCodeLine(iState);

            // Render Physical Pneumatic Scene
            renderScene();

            requestAnimationFrame(gameLoop);
        }

        // --- STEP & CODE HIGHLIGHTERS ---
        function highlightStep(state) {
            [10, 20, 30, 40, 50].forEach(s => {
                const el = document.getElementById(`stepBox${s}`);
                if (!el) return;
                if (state === s) {
                    el.className = "p-2 rounded-lg bg-cyan-950 border border-cyan-400 text-cyan-300 font-bold shadow-[0_0_12px_rgba(6,182,212,0.4)]";
                } else {
                    el.className = "p-2 rounded-lg bg-slate-800 border border-slate-700 text-slate-400";
                }
            });
        }

        function highlightCodeLine(state) {
            [0, 10, 20, 30, 40, 50].forEach(s => {
                const line = document.getElementById(`stLine${s}`);
                if (!line) return;
                if (state === s) {
                    line.className = "block bg-cyan-950/80 border-l-4 border-cyan-400 text-cyan-200 px-2 font-bold";
                } else {
                    line.className = "block text-slate-400 px-2";
                }
            });
        }

        // --- LOGGING SYSTEM ---
        function logEvent(msg, type = "info") {
            const consoleEl = document.getElementById('logConsole');
            if (!consoleEl) return;
            const now = new Date();
            const timeStr = now.toTimeString().split(' ')[0] + '.' + String(now.getMilliseconds()).padStart(3, '0');
            
            let colorClass = "text-slate-300";
            if (type === "warning") colorClass = "text-amber-400";
            if (type === "danger") colorClass = "text-rose-400 font-bold";
            if (type === "success") colorClass = "text-emerald-400 font-bold";

            const entry = document.createElement('div');
            entry.className = `flex space-x-2 ${colorClass}`;
            entry.innerHTML = `<span class="text-slate-500 font-mono text-[10px]">[${timeStr}]</span> <span>${msg}</span>`;
            consoleEl.appendChild(entry);
            consoleEl.scrollTop = consoleEl.scrollHeight;
        }

        function clearLogs() {
            document.getElementById('logConsole').innerHTML = '';
        }

        // --- PARTICLES FOR STAMPING EFFECT ---
        function createSparks() {
            const cx = stampX || canvas.width * 0.65;
            const cy = stampY || canvas.height * 0.60;
            for (let i = 0; i < 25; i++) {
                sparks.push({
                    x: cx,
                    y: cy,
                    vx: (Math.random() - 0.5) * 10,
                    vy: (Math.random() - 0.8) * 8,
                    life: 1.0,
                    color: Math.random() > 0.5 ? '#f59e0b' : '#38bdf8'
                });
            }
        }

        // --- CANVAS RENDERER FOR PNEUMATIC ACTUATORS ---
        function renderScene() {
            const w = canvas.width;
            const h = canvas.height;
            ctx.clearRect(0, 0, w, h);

            // Dark Engineering Grid
            ctx.strokeStyle = '#1e293b';
            ctx.lineWidth = 1;
            const gridSize = 25;
            for (let x = 0; x < w; x += gridSize) {
                ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
            }
            for (let y = 0; y < h; y += gridSize) {
                ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
            }

            // Worktable Surface Geometry
            const tableY = Math.floor(h * 0.66); // Common baseline for workpiece, Cylinder A & Anvil Stop
            const tableX = w * 0.35;
            const tableW = w * 0.58;
            const tableH = 22;

            // Draw Table
            ctx.fillStyle = '#334155';
            ctx.fillRect(tableX, tableY, tableW, tableH);
            ctx.strokeStyle = '#64748b';
            ctx.lineWidth = 2;
            ctx.strokeRect(tableX, tableY, tableW, tableH);

            // Anvil Stop Block (Fixed right wall against which Cylinder A clamps)
            const stopW = 30;
            const stopH = 40;
            const stopX = tableX + tableW - 40;
            const stopY = tableY - stopH;
            ctx.fillStyle = '#475569';
            ctx.fillRect(stopX, stopY, stopW, stopH);
            ctx.strokeStyle = '#94a3b8';
            ctx.strokeRect(stopX, stopY, stopW, stopH);

            // Workpiece Dimensions & Key Alignment Positions
            const pieceW = 50;
            const pieceH = 40;
            const pieceY = tableY - pieceH;
            const clampedPieceX = stopX - pieceW;
            const initialPieceX = tableX + 30;

            // -------------------------------------------------------------------
            // CYLINDER A (Horizontal Clamping Cylinder - Exactly level with Workpiece)
            // -------------------------------------------------------------------
            const cylAX = w * 0.04;
            const cylAW = w * 0.24;
            const cylAH = 40;
            const cylAY = tableY - cylAH; // Perfectly resting on top of table level

            // Cylinder A Body
            ctx.fillStyle = '#1e293b';
            ctx.fillRect(cylAX, cylAY, cylAW, cylAH);
            ctx.strokeStyle = '#94a3b8';
            ctx.lineWidth = 3;
            ctx.strokeRect(cylAX, cylAY, cylAW, cylAH);

            // Piston A Extension & Rod Math
            const maxExtA = clampedPieceX - (cylAX + cylAW);
            const extA = (posA / 100) * maxExtA;

            // Piston Rod A (Centered vertically inside Cylinder A)
            const rodAH = 16;
            const rodAY = cylAY + (cylAH - rodAH) / 2;
            ctx.fillStyle = '#cbd5e1';
            ctx.fillRect(cylAX + cylAW, rodAY, extA, rodAH);
            ctx.strokeStyle = '#64748b';
            ctx.lineWidth = 1.5;
            ctx.strokeRect(cylAX + cylAW, rodAY, extA, rodAH);

            // Clamping Head Pad A (Matches Workpiece Height)
            const padX = cylAX + cylAW + extA;
            ctx.fillStyle = '#06b6d4';
            ctx.fillRect(padX, cylAY, 12, cylAH);
            ctx.strokeStyle = '#38bdf8';
            ctx.lineWidth = 2;
            ctx.strokeRect(padX, cylAY, 12, cylAH);

            // Sensors a0 and a1
            drawSensor(cylAX + 15, cylAY - 14, 'a0', a0);
            drawSensor(cylAX + cylAW - 15, cylAY - 14, 'a1', a1);

            // Dynamic Workpiece Position (Pushed smoothly by Cylinder A to Stop)
            const pieceX = initialPieceX + (posA / 100) * (clampedPieceX - initialPieceX);

            // -------------------------------------------------------------------
            // CYLINDER B (Vertical Stamping Cylinder - Centered over Clamped Workpiece)
            // -------------------------------------------------------------------
            const cylBW = 46;
            const cylBH = Math.floor(h * 0.28);
            const cylBY = Math.floor(h * 0.06);
            
            // Align Cylinder B Centerline with Clamped Workpiece Centerline
            const clampedCenterRangeX = clampedPieceX + (pieceW / 2);
            const cylBX = clampedCenterRangeX - (cylBW / 2);

            // Save Global Spark Hit Coordinates
            stampX = clampedCenterRangeX;
            stampY = pieceY;

            // Cylinder B Body
            ctx.fillStyle = '#1e293b';
            ctx.fillRect(cylBX, cylBY, cylBW, cylBH);
            ctx.strokeStyle = '#94a3b8';
            ctx.lineWidth = 3;
            ctx.strokeRect(cylBX, cylBY, cylBW, cylBH);

            // Piston B Extension Math (Die Pad touches top of Workpiece pieceY at 100%)
            const dieH = 16;
            const maxExtB = pieceY - (cylBY + cylBH) - dieH;
            const extB = (posB / 100) * maxExtB;

            // Piston Rod B (Centered horizontally inside Cylinder B)
            const rodBW = 16;
            const rodBX = cylBX + (cylBW - rodBW) / 2;
            ctx.fillStyle = '#cbd5e1';
            ctx.fillRect(rodBX, cylBY + cylBH, rodBW, extB);
            ctx.strokeStyle = '#64748b';
            ctx.lineWidth = 1.5;
            ctx.strokeRect(rodBX, cylBY + cylBH, rodBW, extB);

            // Die Head Pad B (Stamp)
            const dieY = cylBY + cylBH + extB;
            ctx.fillStyle = '#f59e0b';
            ctx.fillRect(cylBX + 3, dieY, cylBW - 6, dieH);
            ctx.strokeStyle = '#fbbf24';
            ctx.lineWidth = 2;
            ctx.strokeRect(cylBX + 3, dieY, cylBW - 6, dieH);

            // Sensors b0 and b1
            drawSensor(cylBX + cylBW + 14, cylBY + 15, 'b0', b0);
            drawSensor(cylBX + cylBW + 14, cylBY + cylBH - 15, 'b1', b1);

            // -------------------------------------------------------------------
            // WORKPIECE DRAWING & STATUS INDICATORS
            // -------------------------------------------------------------------
            if (workpieceState === 2) {
                ctx.fillStyle = '#10b981'; // Stamped Green Piece
            } else if (workpieceState === 1) {
                ctx.fillStyle = '#38bdf8'; // Clamped Blue Piece
            } else {
                ctx.fillStyle = '#d97706'; // Raw Metallic Amber Piece
            }
            ctx.fillRect(pieceX, pieceY, pieceW, pieceH);
            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 2;
            ctx.strokeRect(pieceX, pieceY, pieceW, pieceH);

            // Stamped Logo / Engraving if stamped
            if (workpieceState === 2) {
                ctx.fillStyle = '#064e3b';
                ctx.font = 'bold 11px monospace';
                ctx.fillText('OK ✓', pieceX + 11, pieceY + 24);
            }

            // Force Clamping Vector Visualizer
            if (posA > 90) {
                ctx.strokeStyle = '#06b6d4';
                ctx.lineWidth = 3;
                ctx.beginPath();
                ctx.moveTo(pieceX - 16, pieceY + 20);
                ctx.lineTo(pieceX - 4, pieceY + 20);
                ctx.stroke();
            }

            // -------------------------------------------------------------------
            // SOLENOID VALVES & AIR TUBING SIMULATION
            // -------------------------------------------------------------------
            drawAirLines(cylAX, cylAY, cylBX, cylBY, cylBW);

            // Render Particle Sparks
            for (let i = sparks.length - 1; i >= 0; i--) {
                const s = sparks[i];
                s.x += s.vx;
                s.y += s.vy;
                s.life -= 0.04;
                
                if (s.life <= 0) {
                    sparks.splice(i, 1);
                    continue;
                }
                
                const radius = Math.max(0, 2.5 * s.life);
                ctx.fillStyle = s.color;
                ctx.beginPath();
                ctx.arc(s.x, s.y, radius, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        // Helper to Draw Proximity / Magnetic Sensors
        function drawSensor(x, y, label, active) {
            ctx.fillStyle = active ? '#10b981' : '#475569';
            ctx.beginPath();
            ctx.arc(x, y, 7, 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = active ? '#a7f3d0' : '#94a3b8';
            ctx.lineWidth = 1.5;
            ctx.stroke();

            // Label Text
            ctx.fillStyle = active ? '#34d399' : '#94a3b8';
            ctx.font = 'bold 11px monospace';
            ctx.fillText(label, x - 7, y - 10);
        }

        // Helper to Draw Dynamic Air Tubes
        function drawAirLines(ax, ay, bx, by, bw) {
            ctx.lineWidth = 2;
            
            // Tube A+ (Y1)
            ctx.strokeStyle = Y1 ? '#06b6d4' : '#334155';
            ctx.beginPath();
            ctx.moveTo(ax + 20, ay + 40);
            ctx.lineTo(ax + 20, ay + 65);
            ctx.stroke();

            // Tube A- (Y2)
            ctx.strokeStyle = Y2 ? '#06b6d4' : '#334155';
            ctx.beginPath();
            ctx.moveTo(ax + 100, ay + 40);
            ctx.lineTo(ax + 100, ay + 65);
            ctx.stroke();

            // Tube B+ (Y3)
            ctx.strokeStyle = Y3 ? '#06b6d4' : '#334155';
            ctx.beginPath();
            ctx.moveTo(bx - 12, by + 15);
            ctx.lineTo(bx, by + 15);
            ctx.stroke();

            // Tube B- (Y4)
            ctx.strokeStyle = Y4 ? '#06b6d4' : '#334155';
            ctx.beginPath();
            ctx.moveTo(bx - 12, by + 75);
            ctx.lineTo(bx, by + 75);
            ctx.stroke();
        }
    </script>
